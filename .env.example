# Copy this file to .env and fill in real values. .env itself is gitignored
# and never committed -- this example file is the only one that is.

# Leave everything below unset to use the free local Ollama path (the
# default for both chat and embeddings). Set these to test against the same
# providers the deployed version uses:

LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional overrides:
# EMBED_PROVIDER=ollama        # e.g. Groq for chat, Ollama for embeddings -- no Gemini key needed then
# APP_SECRET=                  # required only once this backend is actually deployed publicly
# ALLOWED_ORIGIN=              # your deployed frontend's URL, once you have one
